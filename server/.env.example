# Server Environment Configuration Template
# Duplicate this file as .env and fill in the values for your deployment

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Frontend Client URL (Comma-separated for multiple origins, e.g. https://your-frontend.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Security & Secrets
JWT_SECRET=super_secret_cinepass_jwt_token_key_change_in_production
ADMIN_SECRET_KEY=admin123

# Database Connection (MongoDB Atlas URI)
# If left empty, an in-memory MongoDB will be used automatically for local testing
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ticket_booking?retryWrites=true&w=majority

# Email Delivery Configuration:
# OPTION A (RECOMMENDED FOR RENDER & CLOUD DEPLOYMENTS):
# Cloud hosts like Render Free Tier block SMTP ports 25, 465, and 587.
# Resend uses standard HTTPS (port 443), which is NEVER blocked on Render.
# Get your free API key in 30 seconds at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM="CinePass <onboarding@resend.dev>"

# OPTION B: Brevo HTTP API (Alternative HTTP service, 300 free emails/day)
# BREVO_API_KEY=your_brevo_api_key

# OPTION C: Traditional SMTP (Gmail App Password or Custom SMTP)
# Works for local development or VPS/cloud hosts where SMTP is unblocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
EMAIL_FROM="CinePass <your_email@gmail.com>"

# Razorpay Payment Gateway (Test or Live Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
