# Server Environment Configuration Template
# Duplicate this file as .env and fill in the values for your deployment

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Frontend Client URL (Comma-separated for multiple origins, e.g. https://your-frontend.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Security & Secrets
JWT_SECRET=super_secret_cinepass_jwt_token_key_change_in_production
ADMIN_SECRET_KEY=admin123

# Database Connection (MongoDB Atlas URI)
# If left empty, an in-memory MongoDB will be used automatically for local testing
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ticket_booking?retryWrites=true&w=majority

# ==============================================================================
# Transactional Email Delivery (Required for OTP verification in production)
# Choose ONE of the options below:
# ==============================================================================

# OPTION 1: Resend with Verified Custom Domain (Recommended for custom domains)
# 1. Sign up at https://resend.com and get an API key.
# 2. Add and verify your custom domain at https://resend.com/domains (e.g. mail.yourdomain.com).
#    (IMPORTANT: Without a verified domain, Resend's default onboarding@resend.dev sandbox
#     strictly only delivers to your account owner email address).
# 3. Set your verified sender address in EMAIL_FROM.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="CinePass <noreply@yourdomain.com>"
# RESEND_FROM="CinePass <noreply@yourdomain.com>"

# OPTION 2: Brevo (Sendinblue) Transactional API (No Custom Domain Required)
# 1. Sign up for free at https://brevo.com (300 free emails/day to any recipient worldwide).
# 2. Add & verify your personal sender email in Brevo Senders (click confirmation link in email).
# 3. Generate an API Key under SMTP & API -> API Keys.
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
# BREVO_SENDER_NAME="CinePass"

# OPTION 3: Traditional SMTP (Local development or unblocked cloud hosts)
# Note: Cloud hosts like Render Free Tier block outbound SMTP ports 25, 465, and 587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_gmail_app_password

# Razorpay Payment Gateway (Test or Live Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
