# ============================================================
# CINEPASS MERN MOVIE TICKET BOOKING - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Place in server/.env or Render Dashboard)
# ------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Frontend Client URL (Used for CORS - e.g. https://your-frontend.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Security & Tokens
JWT_SECRET=super_secret_cinepass_jwt_token_key_change_in_production
ADMIN_SECRET_KEY=admin123

# MongoDB Connection String (e.g. MongoDB Atlas)
# If omitted or left empty, an embedded MongoDB Memory Server runs automatically for local dev/testing
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ticket_booking?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Production Transactional Email Delivery (Choose Option 1 or Option 2):
# ------------------------------------------------------------------------------
# OPTION 1: Resend with Verified Custom Domain (https://resend.com)
# Note: Resend's default test domain (onboarding@resend.dev) strictly only sends to the account owner's email.
# To send OTPs to all users, add and verify your custom domain in Resend Dashboard (resend.com/domains).
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="CinePass <noreply@yourdomain.com>"
# RESEND_FROM="CinePass <noreply@yourdomain.com>"

# OPTION 2: Brevo (Sendinblue) Transactional API (https://brevo.com - No Custom Domain Required!)
# 300 free emails/day to ANY recipient worldwide. Just verify your sender email in the Brevo dashboard.
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
# BREVO_SENDER_NAME="CinePass"

# OPTION 3: Traditional SMTP (Local Dev or Unblocked Hosts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_gmail_app_password

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Place in client/.env or Vercel Dashboard)
# ------------------------------------------------------------
# URL of your deployed backend API (or localhost:5000 during dev)
VITE_API_URL=http://localhost:5000
